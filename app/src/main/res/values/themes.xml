<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash theme — Android 12+ SplashScreen API -->
    <style name="Theme.NOUS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nous_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.NOUS</item>
    </style>

    <!-- Main theme — Compose handles all styling after splash -->
    <style name="Theme.NOUS" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/nous_bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>
