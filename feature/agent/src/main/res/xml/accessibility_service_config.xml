<?xml version="1.0" encoding="utf-8"?>
<!-- NOUS Accessibility Service Configuration -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused|typeViewTextChanged|typeViewScrolled|typeViewSelected"
    android:accessibilityFeedbackType="feedbackSpoken|feedbackVisual"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canRequestEnhancedWebAccessibility="true"
    android:canRequestFilterKeyEvents="false"
    android:canRequestTouchExplorationMode="true"
    android:packageNames=""
    android:description="@string/nous_accessibility_description" />
