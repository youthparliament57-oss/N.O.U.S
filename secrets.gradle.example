// =============================================================================
// secrets.gradle.example — copy to `secrets.gradle` (gitignored)
//
// This file injects real API keys into BuildConfig at build time.
// NEVER commit the real secrets.gradle to git. The .gitignore blocks it.
// =============================================================================

ext {
    // Cloud LLM provider keys (only used when user opts in)
    nousOpenAiApiKey = "sk-REPLACE_ME"
    nousAnthropicApiKey = "sk-ant-REPLACE_ME"
    nousGeminiApiKey = "AIzaREPLACE_ME"
    nousGroqApiKey = "gsk_REPLACE_ME"
    nousOpenRouterApiKey = "sk-or-REPLACE_ME"

    // Bugsnag / Sentry (optional alternative crash reporters)
    nousBugsnagKey = ""
    nousSentryDsn = ""

    // Play App Signing (upload key alias / password)
    nousSigningKeyAlias = "nous-upload"
    nousSigningKeyPassword = "REPLACE_ME"
    nousSigningStorePassword = "REPLACE_ME"

    // Custom LLM model catalog URL (optional override)
    nousModelCatalogUrl = "https://raw.githubusercontent.com/roshan/nous-models/main/catalog.json"
}
